---

# Generic
generic:
  role: ansible-role-rootca
  role_short: rootca
  role_description: |
    Provisions list of rootCA SSL certificates

# Supported platforms
platforms:
  ubuntu2004:
    supported: true
    ci: true
  alpine3:
    supported: true
    ci: true
  win2012r2:
    supported: true
    ci: false
  win2016:
    supported: true
    ci: false
  win2019:
    supported: true
    ci: false
  win2022:
    supported: true
    ci: false

# Dependencies
dependencies:
  collections: 
    - ansible.windows

# Nolecule
molecule:
  converge:
    vars:
      rootca_certificates:
        - tests/root0.crt
        - src: tests/root1.crt
          state: absent
        - src: tests/root2.pem
          state: present
        - src: tests/root3.pem
          state: present
          os_family: [ 'Windows' ]
        - src: tests/root4.crt
          state: present
          os_family: [ 'RedHat' ]
